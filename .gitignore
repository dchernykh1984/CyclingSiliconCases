# Собранные модели: в репозитории лежит только код и исходники,
# готовые STL собирает CI и прикладывает к релизу
dist/
build/
*.stl
# Кроме исходных моделей: их скачали готовыми, пересобрать их не из чего
!input_data/*.stl
# Превью, которые рендерятся для проверки глазами
preview/
*.png

# Python
__pycache__/
*.py[cod]
.venv/
venv*/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Настройки Claude Code: общие правила и скиллы лежат в репозитории,
# личные разрешения каждого — нет
.claude/settings.local.json

# macOS
.DS_Store
